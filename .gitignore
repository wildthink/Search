# Build output — build.sh regenerates all of this.
.build/
build/
.swiftpm/
*.xcuserstate
.DS_Store

# Python's bytecode cache, left in Tests/ by the probe scripts.
__pycache__/

# Signing material that's tied to one Apple Developer account and should
# never be committed, even though the scripts happily run without it.
*.provisionprofile
*.p12
*.mobileprovision

# code-monkey's Swift index — `code-monkey index` regenerates it from the
# sources, and the audit log is this Mac's own. The config beside it,
# .code-monkey.toml, is tracked.
.code-monkey/
