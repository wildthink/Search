<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<array>
  <!-- A Surfboard catalog: a folder the Finder shows as one file. Owner, as
       the app that makes them; the old Surfboard app, if it is still
       installed, says the same, and the Finder's Open With chooses. -->
  <dict>
    <key>CFBundleTypeName</key><string>Surfboard Catalog</string>
    <key>CFBundleTypeRole</key><string>Editor</string>
    <key>LSHandlerRank</key><string>Owner</string>
    <key>LSTypeIsPackage</key><true/>
    <key>LSItemContentTypes</key>
    <array><string>com.wildthink.surfboard</string></array>
  </dict>
</array>
</plist>
